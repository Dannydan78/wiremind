{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!dist", "!.claude", "!**/*.md", "!**/tests/fixtures"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noAssignInExpressions": "warn",
				"noRedeclare": "on",
				"useIterableCallbackReturn": "on",
				"noTemplateCurlyInString": "on",
				"noSuspiciousSemicolonInJsx": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 2
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
