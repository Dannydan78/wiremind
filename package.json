{
	"name": "wiremind",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun ./index.html",
		"build": "bun build ./index.html --outdir dist",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "biome check . && tsc --noEmit && bun test --pass-with-no-tests"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/bun": "latest",
		"@types/three": "^0.187.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"lil-gui": "^0.21.0",
		"three": "^0.187.0"
	}
}
